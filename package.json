{
  "name": "website-integration",
  "displayName": "Liquid Glass Web Browser",
  "description": "A modern glassmorphism browser inside your VS Code sidebar with proxy bypass.",
  "version": "1.0.0",
  "publisher": "Lunar-Bytes", 
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Lunar-bytes/website-integration-vscode"
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "website-explorer",
          "title": "Web Browser",
          "icon": "assets/icon.png"
        }
      ]
    },
    "views": {
      "website-explorer": [
        {
          "type": "webview",
          "id": "website-integration.sidebarView",
          "name": "Browser",
          "icon": "assets/icon.png"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "url": "^0.11.4"
  }
}